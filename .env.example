# =============================================================================
# PATRIMONIA — variables d'environnement
#
# Copiez ce fichier en `.env.local` puis renseignez vos propres valeurs.
# `.env.local` est ignoré par git : aucune clé secrète ne doit être commitée.
#
# L'application fonctionne SANS aucune de ces variables : elle démarre alors en
# mode démonstration, avec des données clients fictives et des données de marché
# simulées, explicitement signalées dans l'interface.
# =============================================================================

# -----------------------------------------------------------------------------
# Session (serveur uniquement)
# -----------------------------------------------------------------------------
# Secret de signature des sessions de démonstration. Obligatoire en production.
# Générez-le avec : openssl rand -base64 48
AUTH_SECRET=

# URL publique de l'application, utilisée pour construire les liens QR.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — base de données, authentification et stockage
# -----------------------------------------------------------------------------
# Dès que ces deux variables sont renseignées, PATRIMONIA quitte le mode
# démonstration : authentification via Supabase Auth, données lues dans
# PostgreSQL sous Row Level Security, documents dans Supabase Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service. SERVEUR UNIQUEMENT : elle contourne les politiques RLS et ne
# doit jamais être exposée au navigateur ni préfixée par NEXT_PUBLIC_.
# Utilisée seulement par le script d'amorçage `npm run seed:supabase`.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Données de marché
# -----------------------------------------------------------------------------
# auto  : essaie Financial Modeling Prep (si clé) puis Yahoo Finance, sinon mock
# yahoo : Yahoo Finance uniquement (aucune clé requise)
# fmp   : Financial Modeling Prep uniquement (clé requise)
# mock  : force les données simulées, signalées DEMO dans l'interface
MARKET_DATA_PROVIDER=auto

# Clé Financial Modeling Prep (https://site.financialmodelingprep.com).
# Facultative : sans elle, Yahoo Finance est utilisé.
FMP_API_KEY=

# Durée de vie du cache mémoire des réponses de marché, en secondes.
MARKET_DATA_CACHE_TTL=120
